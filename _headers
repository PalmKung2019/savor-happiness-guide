# ── Video: immutable long-term cache ──────────────────────
/video/*.mp4
  Cache-Control: public, max-age=31536000, immutable

# ── Fonts: immutable + CORS ───────────────────────────────
/fonts/*.woff2
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

/fonts/*.css
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# ── CSS & JS: versioned via query string → long cache ─────
# (index.html ใช้ ?v=x.x.x เพื่อ cache bust → immutable ปลอดภัย)
/*.css
  Cache-Control: public, max-age=31536000, immutable

/*.js

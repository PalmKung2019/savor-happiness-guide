# ============================================================
#  SAVOR HAPPINESS — CLOUDFLARE PAGES HEADERS (OPTIMIZED)
#  Security + Cache-Control for Lighthouse 100 Best Practices
# ============================================================

# ── Global Security Headers (all routes) ──────────────────
/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  X-XSS-Protection: 0
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-eval' https://unpkg.com https://cdnjs.cloudflare.com https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://unpkg.com https://cdnjs.cloudflare.com; font-src 'self' https://fonts.gstatic.com https://cdnjs.cloudflare.com; img-src 'self' data: https:; media-src 'self'; connect-src 'self' https://static.cloudflareinsights.com; frame-ancestors 'none';

# ── HTML: never cache (always fresh) ──────────────────────
/index.html
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache

# ── Images: immutable long-term cache ─────────────────────
/img/*.webp
  Cache-Control: public, max-age=31536000, immutable

/img/*.jpg
  Cache-Control: public, max-age=31536000, immutable

/img/*.png
  Cache-Control: public, max-age=31536000, immutable

/img/logo/*.png
  Cache-Control: public, max-age=31536000, immutable

/img/logo/*.jpg
  Cache-Control: public, max-age=31536000, immutable

/img/preview/*.webp
  Cache-Control: public, max-age=31536000, immutable

/img/20ResCafe/*.webp
  Cache-Control: public, max-age=31536000, immutable

# ── Video: immutable long-term cache ──────────────────────
/video/*.mp4
  Cache-Control: public, max-age=31536000, immutable

# ── Fonts: immutable + CORS ───────────────────────────────
/fonts/*.woff2
  Cache-Control: public, max-age=31536000, immutable
  Access-Control-Allow-Origin: *

/fonts/*.css
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# ── CSS & JS: versioned via query string → long cache ─────
/*.css
  Cache-Control: public, max-age=31536000, immutable

/*.js
  Cache-Control: public, max-age=31536000, immutable

# ── Sitemap & SEO files ───────────────────────────────────
/sitemap.xml
  Cache-Control: public, max-age=86400
  Content-Type: application/xml; charset=utf-8
